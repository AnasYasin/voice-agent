# Copy to .env and fill in. .env is gitignored.

# ---- Language ----
AGENT_LANGUAGE=ur-PK

# ---- STT (pick one; both needed during Phase 0 comparison) ----
# elevenlabs | deepgram
STT_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=

# ---- TTS ----
AZURE_SPEECH_KEY=
# centralindia is the closest region to Pakistan, so lower latency
AZURE_SPEECH_REGION=centralindia

# ---- LLM ----
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5

# ---- Audio ----
# Force telephone-band audio even in browser/softphone tests, so what you
# hear in a demo matches what a real 8 kHz call will sound like.
SIMULATE_TELEPHONY=true

TTS_CACHE_DIR=./audio_cache

# ---- LiveKit (local dev values match docker-compose.yml) ----
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_change_me_in_production

# ---- Storage ----
# Every call's transcript goes here. The agent refuses to start without it.
# Locally this matches the postgres service in docker-compose.yml.
DATABASE_URL=postgresql://agent:agent@localhost:5432/voice_agent
# Only deploy/aws reads this, to create the database user. Must be the same
# password DATABASE_URL carries.
POSTGRES_PASSWORD=agent
S3_BUCKET=
AWS_REGION=ap-south-1

# --- component 20: the demo server (make serve) ---
# The code you give people along with the link. demo.py refuses to start
# without one, because the link would otherwise be open to anyone who found it.
DEMO_PASSCODE=change-me
# What the browser dials. Locally this is the same LiveKit the agent uses.
# On the box it is wss://<elastic ip>/rtc, through Caddy.
DEMO_PUBLIC_LIVEKIT_URL=ws://localhost:7880
DEMO_MAX_CALLS=3
DEMO_CALL_SECONDS=300
DEMO_PORT=8080
